# ============================================================
# CloudOps AI Copilot — Environment Variables Example
# ============================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# ----- Application -----
APP_NAME=CloudOps AI Copilot
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# ----- Database -----
DATABASE_URL=postgresql+asyncpg://copilot:copilot_secret@localhost:5432/cloudops_copilot

# ----- Auth / JWT -----
SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----- AI Providers (set at least one) -----
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ----- Default AI Provider -----
DEFAULT_AI_PROVIDER=gemini

# ----- CORS -----
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
